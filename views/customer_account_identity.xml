<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="customer_account_identity_view_form" model="ir.ui.view">
        <field name="name">customer_account_identity_view_form</field>
        <field name="model">customer.account.identity</field>
        <field name="arch" type="xml">
            <form string="customer_account_identity_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="first_name"/>
                            <field name="platform"/>
                        </group>
                        <group>
                            <field name="external_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="customer_account_identity_view_action" model="ir.actions.act_window">
        <field name="name">Customer Account Identity</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">customer.account.identity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>