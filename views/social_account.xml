<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="social_account_view_form" model="ir.ui.view">
        <field name="name">social_account_view_form</field>
        <field name="model">social.acc</field>
        <field name="arch" type="xml">
            <form string="social_account_form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="access_token" password="1"/>
                        <field name="platform"/>
                        <field name="account_id"/>
                        <field name="bot_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="social_account_view_action" model="ir.actions.act_window">
        <field name="name">Social Account</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">social.acc</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>